<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/divisao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.58" />

    <ScrollView
        android:id="@+id/scrollFormulario"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/divisao"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Filmes e Séries"
                android:textSize="22sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="Nome"
                android:inputType="textCapSentences" />

            <Spinner
                android:id="@+id/spTipo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:contentDescription="Tipo da obra" />

            <Spinner
                android:id="@+id/spGenero"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:contentDescription="Gênero da obra" />

            <EditText
                android:id="@+id/edtAno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="Ano de lançamento"
                android:inputType="number" />

            <EditText
                android:id="@+id/edtNota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="Nota pessoal (opcional)"
                android:inputType="numberDecimal" />

            <CheckBox
                android:id="@+id/chkAssistido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Já assistiu?" />

            <Button
                android:id="@+id/btnSalvar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Salvar" />
        </LinearLayout>
    </ScrollView>

    <Spinner
        android:id="@+id/spFiltroTipo"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:contentDescription="Filtrar por tipo"
        app:layout_constraintTop_toBottomOf="@id/divisao"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <CheckBox
        android:id="@+id/chkSomenteAssistidos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Mostrar apenas já assistidos"
        app:layout_constraintTop_toBottomOf="@id/spFiltroTipo"
        app:layout_constraintStart_toStartOf="@id/spFiltroTipo"
        app:layout_constraintEnd_toEndOf="@id/spFiltroTipo" />

    <TextView
        android:id="@+id/txtAjuda"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Toque para editar. Segure para excluir."
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/chkSomenteAssistidos"
        app:layout_constraintStart_toStartOf="@id/spFiltroTipo"
        app:layout_constraintEnd_toEndOf="@id/spFiltroTipo" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFilmes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/txtAjuda"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/spFiltroTipo"
        app:layout_constraintEnd_toEndOf="@id/spFiltroTipo" />
</androidx.constraintlayout.widget.ConstraintLayout>
